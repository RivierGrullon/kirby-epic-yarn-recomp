# SPDX-License-Identifier: GPL-3.0-only
# Packaging only: this image is never shipped to players.
ARG TOOLS_IMAGE=localhost/kirby-portable-tools:compact
FROM ${TOOLS_IMAGE}
COPY requirements-setup.txt /tmp/requirements-setup.txt
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev python3-venv binutils ca-certificates libbz2-1.0 \
    libxcb-cursor0 libxkbcommon-x11-0 libxcb-icccm4 libxcb-keysyms1 \
    libxcb-render-util0 libxcb-xinerama0 libgl1 libegl1 libopengl0 libdbus-1-3 libglib2.0-0t64 fontconfig \
    && rm -rf /var/lib/apt/lists/*
RUN if [ ! -x /opt/freeze/bin/python ]; then python3 -m venv /opt/freeze; fi \
    && /opt/freeze/bin/pip install --no-cache-dir -r /tmp/requirements-setup.txt
