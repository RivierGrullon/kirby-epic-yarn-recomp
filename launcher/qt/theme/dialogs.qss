QMessageBox,QFileDialog,QInputDialog,QDialog#folderView {
    background:#f8f4e9 url(yarnTheme:linen.xpm) repeat;
}
QMessageBox {messagebox-warning-icon:url(yarnTheme:warning-patch.png);}
QMessageBox QLabel#qt_msgbox_label {font-size:19px;font-weight:600;color:#344e3f;}
QMessageBox QLabel#qt_msgbox_informativelabel {color:#405347;}
QMessageBox#fabricConfirm QLabel#qt_msgbox_informativelabel {min-width:300px;}
QFileDialog QTreeView,QFileDialog QListView,QDialog#folderView QTreeView,QLabel#emptyFolder {
    background:#fffdf6;alternate-background-color:#f6f2e7;
    border:1px solid #cfc6ae;border-radius:8px;padding:3px;
    selection-background-color:#efd1d9;selection-color:#493f43;
}
QFileDialog QHeaderView::section,QDialog#folderView QHeaderView::section {
    background:#e2ebdf;color:#405347;border:0;border-right:1px solid #c9d4c5;
    padding:4px 8px;
}
QFileDialog QLineEdit {background:#fffdf6;border:1px solid #cfc6ae;border-radius:7px;padding:5px;}
QFileDialog QLineEdit:focus {border-color:#aa6680;}
QFileDialog QComboBox {
    background:#fffcf1;color:#405347;border:1px dashed #bdb59f;border-radius:9px;
    padding:5px 32px 5px 10px;min-height:22px;
}
QFileDialog QComboBox:hover {background:#f7f6e9;border-color:#a4b29b;}
QFileDialog QComboBox:focus {border:2px solid #ad6a82;padding:4px 31px 4px 9px;}
QFileDialog QComboBox::drop-down {
    subcontrol-origin:border;subcontrol-position:center right;width:32px;border:0;background:transparent;
}
QFileDialog QComboBox::down-arrow {image:url(yarnTheme:dropdown-patch.png);width:20px;height:20px;}
QFileDialog QListView#sidebar {min-width:110px;background:#f5efdf;}
QFileDialog QToolButton {background:transparent;border:1px solid transparent;border-radius:6px;padding:3px;}
QFileDialog QToolButton:hover,QFileDialog QToolButton:checked {background:#e2ebdf;border-color:#b9c8b7;}
QDialogButtonBox QPushButton {
    background:#f5efdf;border:1px dashed #a99b80;border-radius:9px;
    color:#39483e;padding:6px 12px;min-height:22px;
}
QDialogButtonBox QPushButton:hover {background:#f6e5e6;}
QDialogButtonBox QPushButton:focus {border:2px solid #aa6680;}
QDialogButtonBox QPushButton:disabled {background:#eeede4;color:#92958a;}
QMenu {background:#fffaf0;color:#39483e;border:1px dashed #ac9f81;padding:4px;}
QMenu::item {padding:5px 22px;border-radius:5px;}
QMenu::item:selected {background:#efd1d9;color:#493f43;}
QMenu::item:disabled {color:#92958a;}
QMenu::separator {height:1px;background:#d8d0bc;margin:3px 7px;}
