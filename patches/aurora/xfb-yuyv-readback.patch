+// Match the CPU XFB encoder's two quantization steps, including rounding.
+fn xfb_channel(numerator: i32, denominator: i32) -> u32 {
+    let value = (numerator + denominator / 2) / denominator;
+    return u32(clamp((value * 255 + 128) / 256, 0, 255));
+}
+
+fn pack_yuyv(word: u32) -> u32 {
+    let pair = word % params.tilesX;
+    let y = word / params.tilesX;
+    let a = vec3i(load(pair * 2u, y).rgb);
+    let b = vec3i(load(pair * 2u + 1u, y).rgb);
+    let sum = a + b;
+    let y0 = xfb_channel(dot(a, vec3i(66, 129, 25)) + 16 * 255, 255);
+    let y1 = xfb_channel(dot(b, vec3i(66, 129, 25)) + 16 * 255, 255);
+    let u = xfb_channel(dot(sum, vec3i(-38, -74, 112)) + 128 * 510, 510);
+    let v = xfb_channel(dot(sum, vec3i(112, -94, -18)) + 128 * 510, 510);
+    return y0 | (u << 8u) | (y1 << 16u) | (v << 24u);
+}
