 // Extra per-port bindings for game-defined controls, e.g. "metaforce.open_menu".
 void set_action_bindings(uint32_t port, std::vector<binding::Binding> bindings);
 
+// Replace base keyboard/controller bindings for these targets, then add the
+// supplied actions. Source assignment, cancellation and virtual producers are
+// retained. An empty action list can intentionally unbind a replaced control.
+// The two-argument overload restores the base bindings for all targets.
+// sharedKeyboard enables key/mouse actions without selecting exclusive keyboard
+// mode, and keeps the port connected when no physical controller is assigned.
+void set_action_bindings(uint32_t port, std::vector<binding::Binding> bindings,
+                         std::vector<binding::ControlId> replacedControls, bool sharedKeyboard = false);
+
 } // namespace aurora::pad
