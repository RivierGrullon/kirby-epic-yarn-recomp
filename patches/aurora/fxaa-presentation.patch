+
+// Directional FXAA: detect luminance contrast, estimate the edge tangent,
+// then blend along it. Explicit LOD keeps divergent contrast rejection valid.
+fn fxaa_rgb(uv: vec2f) -> vec3f {
+    return textureSampleLevel(efb_texture, efb_sampler, uv, 0.0).rgb;
+}
+fn fxaa_luma(rgb: vec3f) -> f32 {
+    return dot(rgb, vec3f(0.299, 0.587, 0.114));
+}
+@fragment
+fn fs_fxaa(in: VertexOutput) -> @location(0) vec4f {
+    let pixel = 1.0 / vec2f(textureDimensions(efb_texture));
+    let center = fxaa_rgb(in.uv);
+    let m = fxaa_luma(center);
+    let nw = fxaa_luma(fxaa_rgb(in.uv + pixel * vec2f(-1.0, -1.0)));
+    let ne = fxaa_luma(fxaa_rgb(in.uv + pixel * vec2f(1.0, -1.0)));
+    let sw = fxaa_luma(fxaa_rgb(in.uv + pixel * vec2f(-1.0, 1.0)));
+    let se = fxaa_luma(fxaa_rgb(in.uv + pixel * vec2f(1.0, 1.0)));
+    let low = min(m, min(min(nw, ne), min(sw, se)));
+    let high = max(m, max(max(nw, ne), max(sw, se)));
+    if (high - low < max(0.03125, high * 0.125)) {
+        return vec4f(center, 1.0);
+    }
+    let tangent = vec2f((sw + se) - (nw + ne), (nw + sw) - (ne + se));
+    let reduction = max((nw + ne + sw + se) * 0.03125, 0.0078125);
+    let inverse = 1.0 / (min(abs(tangent.x), abs(tangent.y)) + reduction);
+    let step = clamp(tangent * inverse, vec2f(-8.0), vec2f(8.0)) * pixel;
+    let inner = 0.5 * (fxaa_rgb(in.uv - step / 6.0) + fxaa_rgb(in.uv + step / 6.0));
+    let outer = 0.5 * inner + 0.25 * (fxaa_rgb(in.uv - step * 0.5) + fxaa_rgb(in.uv + step * 0.5));
+    let outerLuma = fxaa_luma(outer);
+    return vec4f(select(outer, inner, outerLuma < low || outerLuma > high), 1.0);
 }
 
