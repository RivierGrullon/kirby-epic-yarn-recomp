+
+void preserve_efb_contents() {
+  CHECK(g_recorder.active() && g_recorder.currentRenderPass != UINT32_MAX,
+        "EFB preservation requires an active recording pass");
+  auto& pass = current_render_passes()[g_recorder.currentRenderPass];
+  for (uint32_t i = 0; i < pass.colorAttachmentCount; ++i) {
+    pass.colorAttachments[i].loadOp = wgpu::LoadOp::Load;
+    pass.colorAttachments[i].clear = false;
+  }
+  pass.depthLoadOp = wgpu::LoadOp::Load;
+  pass.clearDepth = false;
+}
 
