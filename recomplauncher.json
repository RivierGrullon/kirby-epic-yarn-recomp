{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "min": "0.90.0-beta.65",
  "repo": "RivierGrullon/kirby-epic-yarn-recomp",
  "name": "Kirby's Epic Yarn Recompiled",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your own USA Wii copy, RK5E01 revision 0: .iso, .wbfs, .rvz, .7z, or a complete extracted DATA folder. Kirby Setup verifies sys/main.dol, not the whole-disc hash.",
    "check": {"ids": ["RK5E01"]}
  },
  "start": {
    "program": ["Kirby-Bridge.exe", "Kirby-Setup-linux-x86_64.AppImage", "AppRun"],
    "args": ["--play", "--destination", "{install}/Game"]
  },
  "prepare": {
    "program": ["Kirby-Bridge.exe", "Kirby-Setup-linux-x86_64.AppImage", "AppRun"],
    "args": ["--prepare", "--game", "{game}", "--destination", "{install}/Game"],
    "label": "Build and verify Kirby from your own disc (downloads build tools)",
    "timeout": 7200,
    "done": ["{install}/Game/kirby-managed.json"],
    "version": "1"
  },
  "config": [{
    "id": "main",
    "format": "toml",
    "file": [{"path": "{install}/Game/local/user/settings.toml"}]
  }],
  "settings": [
    {
      "id": "window", "label": "Window mode",
      "help": "Alt+Enter switches modes during play. Big Picture starts fullscreen.",
      "choices": [
        {"label": "Windowed", "set": {"video/fullscreen": "false"}},
        {"label": "Borderless fullscreen", "set": {"video/fullscreen": "true"}}
      ],
      "defaults": {"video/fullscreen": "false"}
    },
    {
      "id": "vsync", "label": "VSync",
      "choices": [
        {"label": "Off", "set": {"video/vsync": "false"}},
        {"label": "On", "set": {"video/vsync": "true"}}
      ],
      "defaults": {"video/vsync": "false"}
    },
    {
      "id": "resolution", "label": "Internal resolution",
      "help": "Higher values sharpen geometry and use more GPU memory; texture detail is unchanged.",
      "choices": [
        {"label": "1x (native)", "set": {"video/resolution_scale": "1"}},
        {"label": "2x", "set": {"video/resolution_scale": "2"}},
        {"label": "3x", "set": {"video/resolution_scale": "3"}},
        {"label": "4x", "set": {"video/resolution_scale": "4"}},
        {"label": "5x", "set": {"video/resolution_scale": "5"}},
        {"label": "6x", "set": {"video/resolution_scale": "6"}},
        {"label": "8x", "set": {"video/resolution_scale": "8"}}
      ],
      "defaults": {"video/resolution_scale": "1"}
    },
    {
      "id": "antialiasing", "label": "Anti-aliasing",
      "help": "Smooths jagged edges. MSAA keeps detail sharp; FXAA is cheaper but can soften fine detail.",
      "choices": [
        {"label": "Off", "set": {"video/msaa_samples": "1", "video/fxaa": "false"}},
        {"label": "FXAA", "set": {"video/msaa_samples": "1", "video/fxaa": "true"}},
        {"label": "4x MSAA", "set": {"video/msaa_samples": "4", "video/fxaa": "false"}},
        {"label": "4x MSAA + FXAA", "set": {"video/msaa_samples": "4", "video/fxaa": "true"}}
      ],
      "defaults": {"video/msaa_samples": "1", "video/fxaa": "false"}
    },
    {
      "id": "performance", "label": "Experimental performance mode",
      "help": "Keeps more graphics work on the GPU for smoother play. Turn it off if something looks wrong.",
      "choices": [
        {"label": "On", "set": {"kirby/gpu_resident_copies": "true"}},
        {"label": "Off", "set": {"kirby/gpu_resident_copies": "false"}}
      ],
      "defaults": {"kirby/gpu_resident_copies": "true"}
    },
    {
      "id": "volume", "label": "Volume",
      "help": "Master volume, from 0 (silent) to 1 (full).",
      "slider": {"key": "audio/volume", "min": 0, "max": 1, "step": 0.05, "format": "%.2f"},
      "defaults": {"audio/volume": "1.0"}
    }
  ],
  "folders": {
    "game": [{"path": "{install}/Game"}],
    "logs": [{"path": "{install}/Game/logs"}],
    "saves": [{"path": "{install}/Game/local/user/nand/title/00010000/524b3545/data"}]
  }
}
